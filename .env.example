# Only needed outside Coolify (Coolify generates SERVICE_* values itself).
# Copy to .env and fill in. Never commit .env.

# Admin login for the web UI (min. 8 characters). Required: the app refuses to start while empty.
# Generate one with: openssl rand -base64 18
SERVICE_PASSWORD_ADMIN=
ADMIN_USER=admin

# Secret part of the feed URLs. Generate with: openssl rand -hex 32
SERVICE_HEX_64_FEEDTOKEN=

# Public base URL used when displaying feed URLs and for the playlist's guide header (optional;
# otherwise taken from request headers). docker-compose.yml passes it on to the app as PUBLIC_URL.
SERVICE_URL_AIOLINEUP=

# Refresh interval in seconds (0 disables automatic refreshes).
REFRESH_SECONDS=21600
REQUEST_TIMEOUT=60
M3U_MAX_MB=20
EPG_MAX_DOWNLOAD_MB=200
EPG_MAX_DECOMPRESSED_MB=1024
LOG_LEVEL=INFO

# Not in docker-compose.yml by default. Set to true only if you must fetch sources from your LAN.
# ALLOW_PRIVATE_SOURCES=false
